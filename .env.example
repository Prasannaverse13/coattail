# --- Chain (Monad testnet). Alchemy is optional; falls back to the public RPC.
NEXT_PUBLIC_ALCHEMY_KEY=
# --- Envio HyperIndex GraphQL endpoint (from Envio Cloud). Empty = labeled demo data.
NEXT_PUBLIC_ENVIO_URL=
# --- Server-only keys (never prefix with NEXT_PUBLIC_)
NANSEN_API_KEY=
MOONSHOT_API_KEY=
# Kimi base URL: international keys use https://api.moonshot.ai/v1, CN keys https://api.moonshot.cn/v1
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_MODEL=kimi-k3
# Optional: Vercel Blob token for cross-device encrypted vault storage
BLOB_READ_WRITE_TOKEN=
